{
  "name": "Supply",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Obra"
    },
    "project_name": {
      "type": "string",
      "title": "Nome da Obra"
    },
    "name": {
      "type": "string",
      "title": "Material/Servi\u00e7o"
    },
    "category": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "Concreto",
        "A\u00e7o/Ferragem",
        "Alvenaria",
        "Hidr\u00e1ulico",
        "El\u00e9trico",
        "Acabamento",
        "Terraplanagem",
        "Pavimenta\u00e7\u00e3o",
        "Loca\u00e7\u00e3o de Equipamento",
        "M\u00e3o de obra",
        "Outro"
      ]
    },
    "unit": {
      "type": "string",
      "title": "Unidade"
    },
    "quantity_needed": {
      "type": "number",
      "title": "Qtd Necess\u00e1ria"
    },
    "quantity_in_stock": {
      "type": "number",
      "title": "Qtd em Estoque",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "title": "Pre\u00e7o Unit\u00e1rio (R$)"
    },
    "total_value": {
      "type": "number",
      "title": "Valor Total (R$)"
    },
    "supplier": {
      "type": "string",
      "title": "Fornecedor"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Dispon\u00edvel",
        "Baixo estoque",
        "Em falta",
        "Pedido realizado",
        "Entregue"
      ],
      "default": "Dispon\u00edvel"
    },
    "priority": {
      "type": "string",
      "title": "Prioridade",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Urgente"
      ],
      "default": "M\u00e9dia"
    },
    "needed_by": {
      "type": "string",
      "format": "date",
      "title": "Necess\u00e1rio para"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "project_id",
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}