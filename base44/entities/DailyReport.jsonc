{
  "name": "DailyReport",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Obra"
    },
    "project_name": {
      "type": "string",
      "title": "Nome da Obra"
    },
    "report_date": {
      "type": "string",
      "format": "date",
      "title": "Data do Relat\u00f3rio"
    },
    "phase": {
      "type": "string",
      "title": "Etapa da Obra"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Fotos do Dia"
    },
    "observation": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o do Respons\u00e1vel"
    },
    "visible_to_client": {
      "type": "boolean",
      "title": "Vis\u00edvel para o Cliente",
      "default": false
    },
    "ai_report": {
      "type": "string",
      "title": "Relat\u00f3rio Gerado por IA"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Rascunho",
        "Revisado",
        "Publicado",
        "Oculto"
      ],
      "default": "Rascunho"
    },
    "sent_by": {
      "type": "string",
      "title": "Enviado por"
    },
    "client_last_access": {
      "type": "string",
      "title": "\u00daltimo Acesso do Cliente"
    }
  },
  "required": [
    "project_id",
    "report_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}