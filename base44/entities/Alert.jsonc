{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "Documento vencido",
        "Medi\u00e7\u00e3o pendente",
        "Obra atrasada",
        "Score baixo",
        "Contrato pendente",
        "Sem seguro",
        "Pend\u00eancia jur\u00eddica",
        "Avalia\u00e7\u00e3o negativa",
        "Outro"
      ]
    },
    "severity": {
      "type": "string",
      "title": "Severidade",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "default": "M\u00e9dia"
    },
    "related_entity": {
      "type": "string",
      "title": "Entidade Relacionada"
    },
    "related_id": {
      "type": "string",
      "title": "ID Relacionado"
    },
    "is_read": {
      "type": "boolean",
      "title": "Lido",
      "default": false
    },
    "is_resolved": {
      "type": "boolean",
      "title": "Resolvido",
      "default": false
    }
  },
  "required": [
    "title",
    "type",
    "severity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}