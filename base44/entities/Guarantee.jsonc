{
  "name": "Guarantee",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Obra"
    },
    "project_name": {
      "type": "string",
      "title": "Nome da Obra"
    },
    "subcontractor_id": {
      "type": "string",
      "title": "Subempreiteiro"
    },
    "subcontractor_name": {
      "type": "string",
      "title": "Nome do Subempreiteiro"
    },
    "service": {
      "type": "string",
      "title": "Servi\u00e7o"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Conclus\u00e3o"
    },
    "warranty_months": {
      "type": "number",
      "title": "Garantia (meses)",
      "default": 12
    },
    "warranty_end_date": {
      "type": "string",
      "format": "date",
      "title": "Fim da Garantia"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Vencida",
        "Em reclama\u00e7\u00e3o",
        "Encerrada"
      ],
      "default": "Ativa",
      "title": "Status"
    },
    "claims": {
      "type": "string",
      "title": "Reclama\u00e7\u00f5es"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "project_id",
    "subcontractor_id",
    "service"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}