{
  "name": "Document",
  "type": "object",
  "properties": {
    "subcontractor_id": {
      "type": "string",
      "title": "Subempreiteiro"
    },
    "subcontractor_name": {
      "type": "string",
      "title": "Nome do Subempreiteiro"
    },
    "type": {
      "type": "string",
      "title": "Tipo de Documento",
      "enum": [
        "CNPJ",
        "Contrato Social",
        "Certid\u00e3o Negativa",
        "Seguro",
        "ASO",
        "NR-18",
        "NR-35",
        "EPIs",
        "Comprovante Fiscal",
        "Contrato Assinado",
        "Nota Fiscal",
        "ART/RRT",
        "Outro"
      ]
    },
    "file_url": {
      "type": "string",
      "title": "Arquivo"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Aprovado",
        "Pendente",
        "Vencido",
        "Reprovado"
      ],
      "default": "Pendente"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Vencimento"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "subcontractor_id",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}