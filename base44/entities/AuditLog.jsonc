{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "title": "A\u00e7\u00e3o"
    },
    "entity_type": {
      "type": "string",
      "title": "Entidade"
    },
    "entity_id": {
      "type": "string",
      "title": "ID da Entidade"
    },
    "entity_name": {
      "type": "string",
      "title": "Nome da Entidade"
    },
    "details": {
      "type": "string",
      "title": "Detalhes"
    },
    "user_email": {
      "type": "string",
      "title": "Usu\u00e1rio"
    },
    "ip_address": {
      "type": "string",
      "title": "IP"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto",
        "Cr\u00edtico"
      ],
      "title": "N\u00edvel de Risco"
    }
  },
  "required": [
    "action",
    "entity_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}