{
  "name": "HiringRequest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Obra"
    },
    "project_name": {
      "type": "string",
      "title": "Nome da Obra"
    },
    "service_type": {
      "type": "string",
      "title": "Tipo de Servi\u00e7o",
      "enum": [
        "Terraplenagem",
        "Drenagem",
        "Pavimenta\u00e7\u00e3o",
        "Demoli\u00e7\u00e3o",
        "Alvenaria",
        "Acabamento",
        "Estrutura",
        "Instala\u00e7\u00f5es",
        "Limpeza p\u00f3s-obra",
        "Loca\u00e7\u00e3o de Equipamento",
        "Outro"
      ]
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o da Necessidade"
    },
    "location": {
      "type": "string",
      "title": "Localiza\u00e7\u00e3o"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "In\u00edcio Previsto"
    },
    "deadline_days": {
      "type": "number",
      "title": "Prazo (dias)"
    },
    "area_size": {
      "type": "string",
      "title": "Tamanho do Servi\u00e7o (ex: 8.000m\u00b2)"
    },
    "estimated_budget": {
      "type": "number",
      "title": "Or\u00e7amento Estimado (R$)"
    },
    "workers_needed": {
      "type": "number",
      "title": "Funcion\u00e1rios Necess\u00e1rios"
    },
    "equipment_needed": {
      "type": "string",
      "title": "Equipamentos Necess\u00e1rios"
    },
    "technical_requirements": {
      "type": "string",
      "title": "Exig\u00eancias T\u00e9cnicas"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Aberta",
        "Em an\u00e1lise",
        "Proposta recebida",
        "Contratado",
        "Cancelada"
      ],
      "default": "Aberta"
    },
    "hired_subcontractor_id": {
      "type": "string",
      "title": "Empreiteiro Contratado"
    },
    "hired_subcontractor_name": {
      "type": "string",
      "title": "Nome do Contratado"
    },
    "ai_analysis": {
      "type": "string",
      "title": "An\u00e1lise IA"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "service_type",
    "description",
    "location"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}