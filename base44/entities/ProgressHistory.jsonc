{
  "name": "ProgressHistory",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Obra"
    },
    "project_name": {
      "type": "string",
      "title": "Nome da Obra"
    },
    "previous_percent": {
      "type": "number",
      "title": "Percentual Anterior"
    },
    "new_percent": {
      "type": "number",
      "title": "Percentual Novo"
    },
    "observation": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "responsible": {
      "type": "string",
      "title": "Respons\u00e1vel"
    }
  },
  "required": [
    "project_id",
    "new_percent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}