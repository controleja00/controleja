VITE_SUPABASE_URL=https://fnbcbepmwgqwecwlbfco.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_GOOGLE_AUTH=false

# IA usada em relatorios automaticos, assistente e analises.
# Configure somente no ambiente da Vercel, nunca no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Envio de e-mails pela conta oficial da Consuobra no Zoho.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=suporte@consuobra.com.br
SMTP_PASS=
SMTP_FROM=Consuobra <suporte@consuobra.com.br>
MAIL_ALLOWED_TO=suporte@consuobra.com.br,contato@consuobra.com.br,financeiro@consuobra.com.br

# Links publicos de checkout/assinatura criados no Asaas.
# Nunca coloque chave secreta do Asaas no frontend.
VITE_ASAAS_ESSENTIAL_CHECKOUT_URL=
VITE_ASAAS_PROFESSIONAL_CHECKOUT_URL=
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=https://consuobra.com.br
CRON_SECRET=
MONITOR_ALERT_EMAIL=suporte@consuobra.com.br
BLOB_READ_WRITE_TOKEN=

# Futuro webhook Asaas, quando a verificacao documental estiver concluida.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Link publico do WhatsApp comercial usado em botoes de suporte/vendas.
VITE_PUBLIC_WHATSAPP_URL=
